# Copy to deploy/service.env (gitignored) and fill in. Consumed by deploy/install.sh
# to render the LaunchAgent. Keeps real IP/keys out of the repo.
# Values below are tuned for ONE model (qwen3.8-27b) on a 24 GiB M4 Pro — re-derive
# them if you change the registry or the hardware.
MLX_LAZYSERVE_HOST=0.0.0.0
MLX_LAZYSERVE_PORT=41434
# Unload after 10 min idle. The resident set is ~19 GiB of this box's 24 GiB, so holding it
# indefinitely starves everything else; reload from page cache is only ~6s. Set 0 to never
# unload if this machine is dedicated to the service.
MLX_LAZYSERVE_IDLE_TIMEOUT=600
# Output cap = the full context window. Not throttled by wall-clock on purpose: the only real
# ceiling is memory, and prompt + output <= 131072 is exactly the 4.0 GiB of KV already
# budgeted for. Generating past the context would run RoPE outside its trained range anyway.
# (This also matches the model card's own recommendation: final response up to 131,072.)
MLX_LAZYSERVE_MAX_TOKENS=131072
# 21.5 GiB of the 24 GiB unified memory. Not raised further — macOS itself still needs the
# remainder, and Metal allocation failures show up as hard crashes, not graceful fallback.
MLX_LAZYSERVE_WIRED_LIMIT_MB=22000
# 8-bit KV: ~32 KiB/token, so the model's 128k context costs 4.0 GiB. 4-bit would halve that
# but is only worth it if the context ceiling gets raised past 128k.
MLX_LAZYSERVE_KV_BITS=8

# --- Sampling: Qwen3.8-27B's own generation_config.json (temp 1.0 / top_k 20 / top_p 0.95).
# top_p stays hardcoded at 0.95 in server.py, which already matches. Clients override per request.
MLX_LAZYSERVE_TEMPERATURE=1.0
MLX_LAZYSERVE_TOP_K=20
# No min-p: top_k 20 + top_p 0.95 already truncate the tail, and stacking a third cutoff on top
# is not what the model was tuned against.
MLX_LAZYSERVE_MIN_P=0.0
# The model ships NO repetition penalty, and a 27B does not loop the way a 1B does — but this
# is an abliterated build, so keep a light 1.05 rather than 1.0. The real loop protection is
# loop_guard below, which stops degenerate runs outright instead of skewing every token.
MLX_LAZYSERVE_REPETITION_PENALTY=1.05
MLX_LAZYSERVE_REPETITION_CONTEXT=64
MLX_LAZYSERVE_LOOP_GUARD=true

# Bearer token required on /v1/* and /admin/*; empty = open (rely on Tailscale).
MLX_LAZYSERVE_API_KEYS=

# --- Embedded Telegram bot (optional; empty TG_BOT_TOKEN = bot OFF) ---
MLX_LAZYSERVE_TG_BOT_TOKEN=
# Model the bot chats with; empty = server default.
MLX_LAZYSERVE_TG_MODEL=
# context // 2. Past this the bot's own _prompt_budget stops changing (it reserves at most
# half the window for output), so a larger number buys nothing. Thinking is on by default and
# <think> shares this budget with the answer, which is another reason to leave it wide.
MLX_LAZYSERVE_TG_MAX_TOKENS=65536
# 8-bit like the API now: bot prompts are a few thousand tokens, so the KV saving from 4-bit is
# worth well under 100 MB — not a trade worth any quality.
MLX_LAZYSERVE_TG_KV_BITS=8
MLX_LAZYSERVE_TG_TEMPERATURE=1.0
MLX_LAZYSERVE_TG_TOP_K=20
MLX_LAZYSERVE_TG_MIN_P=0.0
MLX_LAZYSERVE_TG_REPETITION_PENALTY=1.05
# Left at 8. The limit here is prefill latency per message, not context — 128k has room for far
# more history than the bot can afford to re-read on every reply.
MLX_LAZYSERVE_TG_HISTORY_TURNS=8
# Owner(s): only they can add the bot to a group (others -> it leaves), and they approve
# strangers' first DM before the bot replies (approved ids saved to SQLite).
MLX_LAZYSERVE_TG_OWNER_IDS=

# --- Group log + recall ---
# The bot already receives every group message (privacy mode is off in BotFather); these
# control whether it keeps them. Recall fires ONLY on an explicit @handle or a tapped-name
# mention — matching display names inside free text is too unreliable to trigger on.
# Rows kept per chat, oldest pruned. 0 disables group logging (and therefore recall).
MLX_LAZYSERVE_TG_GROUP_LOG_CAP=50000
# Messages pulled per mentioned person, and the character cap on the injected block.
# Prefill runs ~70 tok/s here, so every 1000 recalled tokens costs ~14s of latency.
MLX_LAZYSERVE_TG_RECALL_MSGS=10
MLX_LAZYSERVE_TG_RECALL_CHARS=1200

# --- Web tools (Firecrawl) ---
MLX_LAZYSERVE_TG_WEB_TOOLS=true
# Each round costs a full generate plus re-prefilling every tool result so far — measured at
# 150-165s per round on this box, so 3 rounds put a single reply past 8 minutes. 2 still lets
# the model search, read what it found, then answer.
MLX_LAZYSERVE_TG_WEB_MAX_ITERS=2
# Back down from the 12000 I had briefly raised it to. The context window can hold more,
# but prefill is what costs: at ~65 tok/s, 12000 characters is ~2.5 minutes before the model
# answers. Scraped pages are pruned first (nav rows and URLs stripped), which took a 22k-char
# weather page to under 6k, so this cap is now a backstop rather than the usual path.
MLX_LAZYSERVE_TG_WEB_RESULT_CHARS=6000
MLX_LAZYSERVE_TG_WEB_SEARCH_LIMIT=5
MLX_LAZYSERVE_FIRECRAWL_API_KEY=

# Xet is Hugging Face's content-addressed transfer path, and it is the ONLY acceleration
# left in huggingface_hub 1.x (HF_HUB_ENABLE_HF_TRANSFER was removed). Measured on this box
# pulling a 15 GB repo: 37 MB/s with Xet, 6 MB/s without, and the classic CDN path also
# spent most of its time retrying timed-out reads. Set to 1 only if that ever inverts again.
HF_HUB_DISABLE_XET=0
# HF auth. Anonymous pulls start ~10 MB/s then throttle to well under 1 MB/s partway through a
# multi-GB repo; a token keeps full speed. Read scope is enough. Private — this file is gitignored.
HF_TOKEN=
